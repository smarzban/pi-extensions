	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"subagents",
		"agents",
		"orchestration",
		"coding-agent"
	],
	"author": "Saeed Marzban",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/smarzban/pi-extensions.git",
		"directory": "packages/pi-subagents"
	},
	"bugs": {
		"url": "https://github.com/smarzban/pi-extensions/issues"
	},
	"homepage": "https://github.com/smarzban/pi-extensions/tree/main/packages/pi-subagents#readme",
	"engines": {
		"node": ">=18.0.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
