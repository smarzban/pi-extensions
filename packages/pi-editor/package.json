		"editor",
		"stash",
		"draft",
		"input-box",
		"coding-agent"
	],
	"author": "Saeed Marzban",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/smarzban/pi-extensions.git",
		"directory": "packages/pi-editor"
	},
	"bugs": {
		"url": "https://github.com/smarzban/pi-extensions/issues"
	},
	"homepage": "https://github.com/smarzban/pi-extensions/tree/main/packages/pi-editor#readme",
	"engines": {
		"node": ">=20.0.0"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
