{
	"name": "pi-extensions",
	"private": true,
	"description": "Pi extensions monorepo",
	"keywords": [
		"pi-package"
	],
	"workspaces": [
		"packages/*"
	],
	"pi": {
		"extensions": [
			"./packages/pi-pacman",
			"./packages/pi-statusline",
			"./packages/pi-toolview",
			"./packages/pi-editor",
			"./packages/pi-usage",
			"./packages/pi-spawn"
		],
		"themes": [
			"./themes"
		]
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-tui": "*"
	}
}
